# Скопируйте в .env и подставьте свои значения. Файл .env не коммитится.
# Возьмите URL и anon/publishable key из Supabase → Project Settings → API
# (те же, что в локальном admin/supabase-config.js). Не коммитьте ключи.

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_OR_PUBLISHABLE_KEY

# Вход того же пользователя Supabase Auth, что и в админке (роль authenticated).
# Так срабатывают RLS и RPC analytics_dashboard. Отдельный пользователь только
# для Jarvis — нормальный вариант, если ему хватает чтения этих данных.
SUPABASE_EMAIL=you@example.com
SUPABASE_PASSWORD=your-password

# Не подставляйте service_role / sb_secret_*. Этот ключ обходит RLS и может
# менять данные. Сервер сам по себе только читает, но ключ всё равно слишком широкий.
