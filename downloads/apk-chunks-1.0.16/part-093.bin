(function () {
  var PAGE_MIN = 
:root {
  --mushaf-font-family: 
body.plain-wv-pdms .mushaf-text,
body.plain-wv-pdms .basmala,
body.plain-wv-pdms .sura-title-arabic {
  font-family: '^Downloading listening audio\.\.\. (\d+)\/(\d+) already present, (\d+) pending\.$</span>
      <span class="pwv-value">
<div id="mushaf-root">
<div id="mushaf-list-header"></div>
        <div class="page-break-line"></div>
      </div>
      <div class="title-line"></div>
    </div>
  <script>#0B1A14#0c1a14#1c221dMorning adhkar #202124#3D3228#666666#8B6914#8BA888#A89B84#C0C0C0#C4B69Everyone is in it.#D8CCB8#E4D7C0#EFE2C9#F1DDB8#F97066#FFFDF7#b45309#c9a24d#e6e6e6#e7d8b7#e8a0a0d91bb386f8e42d858377a8a7b6c34#edd9ae#f1dca8#mushaf-list-header {
  width: 100%;
  flex-shrink: 0;
  pointer-events: auto;
  direction: ltr;
  text-align: left;
  font-family: -apple-system, system-ui, "Segoe UI", sans-serif;
  padding: 6px 0 12px;
  box-sizing: border-box;
  -webkit-user-select: none;
  user-select: none;
}
#mushaf-list-header * { box-sizing: border-box; }
#mushaf-list-header button {
  appearance: none;
  border: 0;
  background: transparent;
  padding: 0;
  font: inherit;
  color: inherit;
  text-align: left;
}
.pwv-chrome {
  border-radius: 20px;
  border: 1px solid;
  padding: 12px;
}
.pwv-row {
  display: flex;
  align-items: center;
  gap: 10px;
  width: 100%;
  min-height: 48px;
}
.pwv-well {
  width: 36px;
  height: 36px;
  border-radius: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.pwv-copy { flex: 1; min-width: 0; }
.pwv-kicker {
  display: block;
  font-size: 12px;
  font-weight: 600;
  line-height: 15px;
}
.pwv-value {
