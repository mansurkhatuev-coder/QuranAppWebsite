body.classic-mode .mushaf-page-card { display: none; }
body.classic-mode .mushaf-page-card.is-classic-visible { display: block; }
.mushaf-page-card {
  margin-top: 8px;
  padding-top: 20px;
  padding-bottom: 20px;
  padding-left: var(--mushaf-page-padding);
  padding-right: var(--mushaf-page-padding);
  box-shadow: 0 10px 18px rgba(0,0,0,0.12);
}
.mushaf-chunk { margin-bottom: 10px; }
.sura-title-row {
  width: 100%;
  min-width: 0;
  gap: 10px !important;
  margin-bottom: calc(8px * var(--mushaf-font-scale, 1)) !important;
  align-items: center;
}
.sura-title-row + .basmala {
  margin-top: calc(6px * var(--mushaf-font-scale, 1)) !important;
}
.sura-title-row + .mushaf-text {
  margin-top: calc(10px * var(--mushaf-font-scale, 1));
}
.title-line {
  flex: 1 1 8px !important;
  min-width: 8px !important;
  max-width: 82px !important;
}
.sura-title-badge {
  flex: 0 1 auto !important;
  min-width: 0 !important;
  max-width: 78% !important;
  box-sizing: border-box;
  padding: calc(11px * var(--mushaf-font-scale, 1)) calc(20px * var(--mushaf-font-scale, 1)) !important;
}
body.light-chrome .sura-title-badge,
body:not(.dark) .sura-title-badge {
  background: rgba(255, 252, 245, 0.98) !important;
  border-color: rgba(169, 117, 26, 0.44) !important;
  box-shadow: 0 3px 10px rgba(139, 105, 20, 0.14);
}
body.light-chrome .sura-title-arabic,
body:not(.dark) .sura-title-arabic {
  color: #4A3210 !important;
}
body.light-chrome .title-line,
body:not(.dark) .title-line {
  border-top-color: rgba(169, 117, 26, 0.42) !important;
}
.sura-title-arabic {
  font-size: calc(32px * var(--mushaf-font-scale, 1)) !important;
  line-height: 1.55 !important;
  padding: 0.04em 0.08em;
  text-align: center;
  white-space: nowrap;
}
.basmala {
  font-size: calc(30px * var(--mushaf-font-scale, 1)) !important;
  line-height: 1.85 !important;
  margin-top: 0 !important;
  margin-bottom: calc(10px * var(--mushaf-font-scale, 1)) !important;
  padding: 0.08em 0.16em;
}
.basmala + .mushaf-text {
  margin-top: calc(4px * var(--mushaf-font-scale, 1));
}
.page-break-row {
  margin: 8px 0 6px !important;
  gap: 12px !important;
}
.page-break-badge {
  width: 92px !important;
  height: 44px !important;
  min-width: 92px;
  padding: 0 !important;
  font-size: 24px !important;
  box-sizing: border-box;
}
.mushaf-text {
  padding-left: 4px;
  padding-right: 4px;
  overflow: visible;
}
.mushaf-text .ayah {
  padding: 0 2px !important;
  border-radius: 6px !important;
  /* Reserve highlight geometry; color only flips on state classes. */
  border-width: 1.4px !important;
  border-style: solid !important;
  border-color: transparent !important;
}
.mushaf-text .ayah.is-playing {
  border-color: var(--mushaf-active-border) !important;
}
.mushaf-text .ayah.is-playing.active {
  border-color: var(--mushaf-active-border-playing) !important;
}
.mushaf-text .ayah.is-jump {
  border-color: var(--mushaf-jump-border) !important;
}
.mushaf-text .ayah.is-reading {
  border-color: var(--mushaf-reading-border) !important;
}
.ayah-marker {
  font-size: calc(16px * var(--mushaf-font-scale, 1)) !important;
  opacity: 0.66 !important;
  font-weight: 600 !important;
  color: var(--mushaf-marker) !important;
  margin: 0 7px !important;
  font-family: var(--mushaf-font-family), 'Noto Naskh Arabic', 'Scheherazade New', serif !important;
}
    <article class="mushaf-page-card" data-page="findLastIndexps?:\/\/.*?\/--\/(.*)\?(.+); true;
