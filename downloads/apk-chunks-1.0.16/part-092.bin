This error is located at::list=_worklet_6765275246935_init_datacademy.knowledge.q.musaHelper.opt.harun-circlearDiskCachechnya-boundary.json: invalid vertexerciseIdgham always has ghunnah.academy.tajweed.beginner.makhraj.yacademy.madina.lessonMissing default exportsentora_yurtodayPctisInAParentTextractExactPathFromURLISTENING_AUDIO_GITHUB_OWNERNSScreenStackHeaderConfigloose invalid filter is not a string or arrayFormatSeparator must be single character stringifyTransformArrayPropshadowsTs3FactoryCannot find host instance for this component. Maybe it renders nothing?anon_0_entriesisCountryFeature flags cannot be overridden more than onceiling-light-outlineacademy.tuhfat.l7.ex.ammagazine-riflexDirection to the Kaaba from your city-variant-outline&#39;

  function post(type, payload) {
    payload = payload || {};
    payload.type = type;
    if (window.ReactNativeWebView) {
      window.ReactNativeWebView.postMessage(JSON.stringify(payload));
    }
  }

  function clamp(n, min, max) {
    return Math.min(Math.max(n, min), max);
  }

  function getSlot(page) {
    return document.getElementById('page-slot-' + page);
  }

  function quoteFontFamily(name) {
    if (!name) return 'serif';
    if (name.indexOf(' ') >= 0 || name.indexOf(',') >= 0) {
      return "'" + name.replace(/'/g, "\'") + "'";
    }
    return name;
  }

  function measureSlotHeight(page) {
    var slot = getSlot(page);
    if (!slot) return pageHeights[page - 1] || 0;
    if (materialized[page]) {
      slot.style.height = 'auto';
      return Math.round(Math.max(slot.scrollHeight, slot.offsetHeight, 48));
    }
    return pageHeights[page - 1] || 0;
  }

  function applySlotHeight(page, height) {
    var slot = getSlot(page);
    if (!slot) return;
    pageHeights[page - 1] = height;
    slot.style.minHeight = height + 'px';
    if (materialized[page]) {
      slot.style.height = 'auto';
    } else {
      slot.style.height = height + 'px';
    }
  }

  function rebuildAllOffsets() {
    var cumulative = 0;
    for (var p = PAGE_MIN; p <= PAGE_MAX; p += 1) {
      pageOffsets[p - 1] = cumulative;
      cumulative += pageHeights[p - 1] || 0;
    }
  }

  function relayoutAllSlots(anchorPage) {
    anchorPage = clamp(anchorPage || detectVisiblePage(), PAGE_MIN, PAGE_MAX);
    for (var p = PAGE_MIN; p <= PAGE_MAX; p += 1) {
      var h = measureSlotHeight(p);
      applySlotHeight(p, h);
    }
    rebuildAllOffsets();
    scrollToPage(anchorPage, 0.08, false);
  }

  function measureAndUpdateHeight(page) {
    if (!materialized[page]) return;
    var h = measureSlotHeight(page);
    if (Math.abs(h - pageHeights[page - 1]) < 2) return;
    applySlotHeight(page, h);
    rebuildAllOffsets();
  }

  function dematerializePage(page) {
    if (!materialized[page]) return;
    var slot = getSlot(page);
    if (!slot) return;
    var h = pageHeights[page - 1];
    slot.innerHTML = '';
    slot.style.minHeight = h + 'px';
    slot.style.height = h + 'px';
    delete materialized[page];
  }

  function applyHighlight() {
    document.querySelectorAll('.ayah[data-key]').forEach(function (el) {
      var key = el.getAttribute('data-key');
      el.classList.remove('is-playing', 'is-jump', 'is-reading', 'active');
      if (highlight.playbackKey && key === highlight.playbackKey) {
        el.classList.add('is-playing');
        if (highlight.isPlaying) el.classList.add('active');
      } else if (highlight.jumpKey && key === highlight.jumpKey) {
        el.classList.add('is-jump');
      } else if (!highlight.isPlaying && highlight.readingKey && key === highlight.readingKey) {
        el.classList.add('is-reading');
      }
    });
  }

  function setPages(pages) {
    Object.keys(pages).forEach(function (key) {
      var page = parseInt(key, 10);
      var slot = getSlot(page);
      if (!slot) return;
      slot.innerHTML = pages[key];
      materialized[page] = true;
      requestAnimationFrame(function () {
        measureAndUpdateHeight(page);
        if (pendingScroll && pendingScroll.page === page) {
          scrollToPage(pendingScroll.page, pendingScroll.viewPosition, pendingScroll.animated);
          pendingScroll = null;
        }
      });
    });
    applyHighlight();
  }

  function setTheme(theme) {
    var root = document.documentElement;
    root.style.setProperty('--mushaf-page-bg', theme.pageBg);
    root.style.setProperty('--mushaf-page-border', theme.pageBorder);
    root.style.setProperty('--mushaf-ink', theme.pageText);
    root.style.setProperty('--mushaf-sura-line', theme.suraLine);
    root.style.setProperty('--mushaf-sura-badge-bg', theme.suraBadgeBg);
    root.style.setProperty('--mushaf-sura-badge-border', theme.suraBadgeBorder);
    root.style.setProperty('--mushaf-sura-badge-text', theme.suraBadgeText);
    root.style.setProperty('--mushaf-divider-line', theme.dividerLine);
    root.style.setProperty('--mushaf-divider-badge-bg', theme.dividerBadgeBg);
    root.style.setProperty('--mushaf-divider-badge-text', theme.dividerBadgeText);
    root.style.setProperty('--mushaf-active-bg', theme.activeAyahBg);
    root.style.setProperty('--mushaf-active-border', theme.activeAyahBorder);
    root.style.setProperty('--mushaf-active-border-playing', theme.activeAyahBorderPlaying);
    root.style.setProperty('--mushaf-jump-bg', theme.jumpAyahBg);
    root.style.setProperty('--mushaf-jump-border', theme.jumpAyahBorder);
    root.style.setProperty('--mushaf-reading-bg', theme.readingAyahBg);
    root.style.setProperty('--mushaf-reading-border', theme.readingAyahBorder);
    root.style.setProperty('--mushaf-reading-shadow', theme.readingAyahBoxShadow);
    root.style.setProperty('--mushaf-marker', theme.defaultMarkerText);
    root.style.setProperty('--mushaf-marker-active', theme.activeMarkerText);
    root.style.setProperty('--mushaf-marker-jump', theme.jumpMarkerText);
    root.style.setProperty('--mushaf-marker-reading', theme.readingMarkerText);
    document.body.classList.toggle('dark', !!theme.isDark);
  }

  function setTypography(typography) {
    var root = document.documentElement;
    root.style.setProperty('--mushaf-font-family', quoteFontFamily(typography.fontFamily));
    root.style.setProperty('--mushaf-line-height', typography.lineHeight + 'px');
    root.style.setProperty('--mushaf-page-padding', typography.pagePadding + 'px');
  }

  function setFontScale(scale) {
    var next = Math.max(0.85, scale);
    var ratio = currentFontScale > 0 ? next / currentFontScale : 1;
    currentFontScale = next;
    document.documentElement.style.setProperty('--mushaf-font-scale', String(next));
    var base = 34 * next;
    document.documentElement.style.setProperty('--mushaf-font-size', base + 'px');
    if (Math.abs(ratio - 1) < 0.001) return;
    for (var p = PAGE_MIN; p <= PAGE_MAX; p += 1) {
      pageHeights[p - 1] = Math.round(pageHeights[p - 1] * ratio);
      applySlotHeight(p, pageHeights[p - 1]);
    }
    rebuildAllOffsets();
    requestAnimationFrame(function () {
      relayoutAllSlots(visiblePage);
    });
  }

  function syncLayout(estimates, anchorPage) {
    if (estimates && estimates.length === PAGE_MAX) {
      for (var p = PAGE_MIN; p <= PAGE_MAX; p += 1) {
        if (!materialized[p]) {
          pageHeights[p - 1] = estimates[p - 1];
          applySlotHeight(p, estimates[p - 1]);
        }
      }
    }
    requestAnimationFrame(function () {
      relayoutAllSlots(anchorPage || visiblePage);
    });
  }

  function scrollToPage(page, viewPosition, animated) {
    page = clamp(page, PAGE_MIN, PAGE_MAX);
    viewPosition = viewPosition == null ? 0.08 : viewPosition;
    if (!materialized[page]) {
      pendingScroll = { page: page, viewPosition: viewPosition, animated: !!animated };
      post('requestPages', { pages: [page] });
      return;
    }
    var offset = pageOffsets[page - 1];
    var height = pageHeights[page - 1];
    var target = offset - (window.innerHeight - height) * viewPosition;
    window.scrollTo({ top: Math.max(0, target), behavior: animated ? 'smooth' : 'auto' });
    if (!animated) {
      requestAnimationFrame(function () {
        window.scrollTo({ top: Math.max(0, target), behavior: 'auto' });
      });
    }
  }

  function scrollToAyah(ayahKey, viewPosition, animated) {
    var el = document.querySelector('.ayah[data-key="' + ayahKey + '"]');
    if (!el) {
      var parts = ayahKey.split(':');
      var sura = parseInt(parts[0], 10);
      var ayah = parseInt(parts[1], 10);
      post('requestPages', { pages: [] });
      return;
    }
    var rect = el.getBoundingClientRect();
    var absoluteTop = window.scrollY + rect.top;
    var vp = viewPosition == null ? 0.5 : viewPosition;
    var target = absoluteTop - (window.innerHeight - rect.height) * vp;
    window.scrollTo({ top: Math.max(0, target), behavior: animated ? 'smooth' : 'auto' });
  }

  function setClassicMode(enabled, page) {
    classicMode = !!enabled;
    classicPage = clamp(page || classicPage, PAGE_MIN, PAGE_MAX);
    document.body.classList.toggle('classic-mode', classicMode);
    if (classicMode) {
      scrollToPage(classicPage, 0, false);
    }
  }

  function requestNearbyPages(centerPage) {
    var pages = [];
    for (var p = centerPage - MATERIALIZE_RADIUS; p <= centerPage + MATERIALIZE_RADIUS; p += 1) {
      if (p < PAGE_MIN || p > PAGE_MAX) continue;
      if (!materialized[p]) pages.push(p);
    }
    if (pages.length) post('requestPages', { pages: pages });
  }

  function recycleFarPages(centerPage) {
    Object.keys(materialized).forEach(function (key) {
      var page = parseInt(key, 10);
      if (Math.abs(page - centerPage) > MATERIALIZE_RADIUS + 2) {
        dematerializePage(page);
      }
    });
  }

  function detectVisiblePage() {
    var scrollY = window.scrollY;
    var probe = scrollY + window.innerHeight * 0.12;
    var lo = PAGE_MIN;
    var hi = PAGE_MAX;
    while (lo < hi) {
      var mid = Math.floor((lo + hi + 1) / 2);
      if (pageOffsets[mid - 1] <= probe) lo = mid;
      else hi = mid - 1;
    }
    return lo;
  }

  function onScrollSettled() {
    if (classicMode) return;
    var page = detectVisiblePage();
    if (page !== visiblePage) {
      visiblePage = page;
      post('visiblePage', { page: page });
    }
    requestNearbyPages(page);
    recycleFarPages(page);
    post('scrollSettled', { page: page, offset: window.scrollY });
  }

  function setupObservers() {
    var observer = new IntersectionObserver(
      function (entries) {
        entries.forEach(function (entry) {
          var page = parseInt(entry.target.getAttribute('data-page') || '0', 10);
          if (!page) return;
          if (entry.isIntersecting) requestNearbyPages(page);
        });
      },
      { root: null, rootMargin: '240px 0px', threshold: 0 }
    );
    for (var p = PAGE_MIN; p <= PAGE_MAX; p += 1) {
      var slot = getSlot(p);
      if (slot) observer.observe(slot);
    }
  }

  function setupAyahGestures() {
    var root = document.getElementById('mushaf-root');
    if (!root) return;
    var longPressFired = false;

    root.addEventListener('touchstart', function (e) {
      var target = e.target.closest('.ayah[data-key]');
      if (!target) return;
      var ayahKey = target.getAttribute('data-key');
      longPressKey = ayahKey;
      longPressFired = false;
      clearTimeout(longPressTimer);
      if (ayahKey && !highlight.isPlaying) {
        highlight.readingKey = ayahKey;
        applyHighlight();
        post('ayahPressIn', { ayahKey: ayahKey });
      } else if (ayahKey) {
        post('ayahPressIn', { ayahKey: ayahKey });
      }
      longPressTimer = setTimeout(function () {
        longPressFired = true;
        if (longPressKey) post('ayahLongPress', { ayahKey: longPressKey });
        longPressKey = null;
      }, 450);
    }, { passive: true });

    root.addEventListener('touchend', function () {
      clearTimeout(longPressTimer);
      longPressKey = null;
    }, { passive: true });

    root.addEventListener('touchmove', function () {
      clearTimeout(longPressTimer);
      longPressKey = null;
    }, { passive: true });

    root.addEventListener('click', function (e) {
      var target = e.target.closest('.ayah[data-key]');
      if (!target) return;
      e.preventDefault();
      if (longPressFired) {
        longPressFired = false;
        return;
      }
      var ayahKey = target.getAttribute('data-key');
      if (!ayahKey) return;
      post('ayahTap', { ayahKey: ayahKey });
    });
  }

  window.addEventListener('scroll', function () {
    clearTimeout(scrollEndTimer);
    scrollEndTimer = setTimeout(onScrollSettled, 80);
  }, { passive: true });

  function invalidateAllPages() {
    Object.keys(materialized).forEach(function (key) {
      dematerializePage(parseInt(key, 10));
    });
  }

  window.__mushafBridge = {
    handleMessage: function (msg) {
      if (!msg || !msg.type) return;
      switch (msg.type) {
        case 'setPages': setPages(msg.pages || {}); break;
        case 'setTheme': setTheme(msg.theme); break;
        case 'setTypography': setTypography(msg.typography); break;
        case 'setFontScale': setFontScale(msg.fontScale); break;
        case 'syncLayout': syncLayout(msg.estimates, msg.anchorPage); break;
        case 'setHighlight':
          highlight = msg.highlight || highlight;
          applyHighlight();
          break;
        case 'scrollToPage':
          scrollToPage(msg.page, msg.viewPosition, msg.animated);
          break;
        case 'scrollToAyah':
          scrollToAyah(msg.ayahKey, msg.viewPosition, msg.animated);
          break;
        case 'setClassicMode':
          setClassicMode(msg.enabled, msg.page);
          break;
        case 'invalidatePages':
          invalidateAllPages();
          break;
        default:
          break;
      }
    },
  };

  setupObservers();
  setupAyahGestures();
