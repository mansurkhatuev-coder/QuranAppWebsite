:root {
  --mushaf-font-size: 34px;
  --mushaf-line-height: 82px;
  --mushaf-page-bg: #fffdf7;
  --mushaf-page-border: #d2b98a;
  --mushaf-ink: #17100b;
  --mushaf-page-padding: 14px;
  --mushaf-list-padding: 12px;
  --mushaf-active-bg: rgba(201, 162, 77, 0.18);
  --mushaf-active-border: rgba(201, 162, 77, 0.72);
  --mushaf-active-border-playing: rgba(201, 162, 77, 1);
  --mushaf-jump-bg: rgba(201, 162, 77, 0.14);
  --mushaf-jump-border: rgba(201, 162, 77, 0.55);
  --mushaf-reading-bg: rgba(201, 162, 77, 0.12);
  --mushaf-reading-border: rgba(201, 162, 77, 0.45);
  --mushaf-reading-shadow: 0 4px 12px rgba(201, 162, 77, 0.12);
  --mushaf-marker: rgba(23, 16, 11, 0.66);
  --mushaf-marker-active: rgba(201, 162, 77, 0.95);
  --mushaf-marker-jump: rgba(201, 162, 77, 0.9);
  --mushaf-marker-reading: rgba(26, 21, 13, 0.9);
  --mushaf-font-family: 'UthmanicHafs', 'Kitab', serif;
}
* { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
html, body {
  margin: 0;
  padding: 0;
  background: transparent;
  overflow-x: hidden;
  -webkit-overflow-scrolling: touch;
  -webkit-user-select: none;
  user-select: none;
  -webkit-touch-callout: none;
}
body.classic-mode #mushaf-root {
  overflow: hidden;
  height: 100vh;
}
#mushaf-root {
  padding: 6px var(--mushaf-list-padding) 24px;
  -webkit-user-select: none;
  user-select: none;
  -webkit-touch-callout: none;
}
.mushaf-page-slot {
  width: 100%;
}
.mushaf-page-card {
  margin-top: 8px;
  border-radius: 22px;
  border: 1px solid var(--mushaf-page-border);
  background: var(--mushaf-page-bg);
  color: var(--mushaf-ink);
  padding: 20px var(--mushaf-page-padding);
  box-shadow: 0 10px 18px rgba(0,0,0,0.12);
}
.mushaf-chunk { margin-bottom: 10px; }
.sura-title-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  margin-bottom: 2px;
}
.title-line {
  flex: 1;
  max-width: 82px;
  border-top: 1px solid var(--mushaf-sura-line, rgba(169,117,26,0.42));
}
.sura-title-badge {
  border-radius: 18px;
  border: 1px solid var(--mushaf-sura-badge-border, rgba(169,117,26,0.44));
  background: var(--mushaf-sura-badge-bg, rgba(255,252,245,0.98));
  padding: 9px 20px;
  text-align: center;
}
.sura-title-arabic {
  font-family: var(--mushaf-font-family);
  font-size: calc(32px * var(--mushaf-font-scale, 1));
  line-height: calc(50px * var(--mushaf-font-scale, 1));
  direction: rtl;
  color: var(--mushaf-sura-badge-text, #4a3210);
}
.basmala {
  font-family: var(--mushaf-font-family);
  font-size: calc(30px * var(--mushaf-font-scale, 1));
  line-height: calc(56px * var(--mushaf-font-scale, 1));
  text-align: center;
  direction: rtl;
  margin-bottom: 10px;
}
.mushaf-text {
  font-family: var(--mushaf-font-family);
  font-size: var(--mushaf-font-size);
  line-height: var(--mushaf-line-height);
  direction: rtl;
  text-align: justify;
  text-align-last: right;
  unicode-bidi: plaintext;
  color: var(--mushaf-ink);
  margin: 0;
  padding: 0;
  width: 100%;
}
.mushaf-text .ayah {
  display: inline;
  border-radius: 14px;
  padding: 3px 7px;
  /* Reserve border box so play/jump/reading highlight never reflows ayah positions. */
  border: 1.4px solid transparent;
  -webkit-user-select: none;
  user-select: none;
  -webkit-touch-callout: none;
}
.mushaf-text .ayah.is-playing {
  background: var(--mushaf-active-bg);
  border-color: var(--mushaf-active-border);
}
.mushaf-text .ayah.is-playing.active {
  border-color: var(--mushaf-active-border-playing);
  box-shadow: 0 2px 14px rgba(201,162,77,0.28);
}
.mushaf-text .ayah.is-jump {
  background: var(--mushaf-jump-bg);
  border-color: var(--mushaf-jump-border);
}
.mushaf-text .ayah.is-reading {
  background: var(--mushaf-reading-bg);
  border-color: var(--mushaf-reading-border);
  box-shadow: var(--mushaf-reading-shadow);
}
.ayah-marker {
  font-size: calc(16px * var(--mushaf-font-scale, 1));
  opacity: 0.66;
  margin: 0 7px;
  color: var(--mushaf-marker);
}
.ayah.is-playing .ayah-marker { color: var(--mushaf-marker-active); opacity: 0.94; }
.ayah.is-jump .ayah-marker { color: var(--mushaf-marker-jump); opacity: 0.9; }
.ayah.is-reading .ayah-marker { color: var(--mushaf-marker-reading); opacity: 0.9; }
.page-break-row {
  margin: 8px 0 6px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12px;
}
.page-break-line {
  flex: 1;
  border-top: 1px solid var(--mushaf-divider-line, rgba(0,0,0,0.2));
}
.page-break-badge {
  width: 92px;
  height: 44px;
  border-radius: 999px;
  background: var(--mushaf-divider-badge-bg, #f4e7cc);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24px;
  font-weight: 600;
  color: var(--mushaf-divider-badge-text, #6d4a16);
}
.tajweed-text span { pointer-events: none; }
.tajweed-text [class^="mt-"],
.tajweed-text [class*=" mt-"] {
  font-family: inherit;
}
