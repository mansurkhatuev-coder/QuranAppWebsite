  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@mediabunny/aac-encoder": "1.56.1",
    "@remotion/bundler": "4.0.532",
    "@remotion/cli": "4.0.532",
    "@remotion/player": "4.0.532",
    "@remotion/renderer": "4.0.532",
    "mediabunny": "1.56.1",
    "react": "19.2.3",
